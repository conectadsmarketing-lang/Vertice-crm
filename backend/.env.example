# Porta do servidor backend
PORT=3001

# Chave de API do Gemini (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Evolution API (WhatsApp) ───────────────────────────────────────────────
# URL da sua instância Evolution API (self-hosted ou nuvem)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key_here

# Nome da instância WhatsApp no Evolution API
EVOLUTION_INSTANCE_NAME=vertice-crm

# ─── Webhook ─────────────────────────────────────────────────────────────────
# URL pública deste backend (para registrar no Evolution API)
# Em desenvolvimento: use ngrok ou cloudflare tunnel
WEBHOOK_BASE_URL=https://your-public-url.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL do frontend (para liberar CORS)
FRONTEND_URL=http://localhost:5173

# ─── Armazenamento ───────────────────────────────────────────────────────────
# Diretório para salvar dados (relativo ao backend/)
DATA_DIR=./data
